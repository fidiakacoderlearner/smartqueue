<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartqueue.controller.AdminSettingsController">
    <VBox alignment="TOP_CENTER" spacing="10.0" styleClass="root">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT">
            <Button text="&lt; Kembali ke Panel Antrian" onAction="#onKembali" styleClass="button-flat"/>
        </HBox>


        <Label text="PENGATURAN PROFILE" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Separator/>

        <Label fx:id="lblStatusAdmin" style="-fx-font-weight: bold;"
               wrapText="true"/>
        <Separator/>

        <Label text="UPDATE INFORMASI ASISTENSI (Global Info):" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="txtInputInfo" prefHeight="50" promptText="Masukkan tempat dan waktu asistensi hari ini..."/>
        <Button text="UPDATE INFO" onAction="#onUpdateInfo" styleClass="info" maxWidth="Infinity"/>

        <Separator/>

        <Label text="GANTI USERNAME:" style="-fx-font-weight: bold;"/>
        <HBox spacing="10">
            <TextField fx:id="txtNewUsername" promptText="Username Baru" HBox.hgrow="ALWAYS"/>
            <Button text="GANTI" onAction="#onGantiUsername" styleClass="warning"/>
        </HBox>

        <Separator/>
        <Label text="ATUR WAKTU TUNGGU (GRACE PERIOD):" style="-fx-font-weight: bold;"/>
        <Label text="(Waktu bagi mahasiswa untuk hadir setelah dipanggil, dalam detik)"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtWaktuTunggu" promptText="Detik (cth: 30)" HBox.hgrow="ALWAYS"/>
            <Button text="UPDATE" onAction="#onUpdateWaktuTunggu" styleClass="info"/>
        </HBox>
        <Separator/>

        <Label text="GANTI PASSWORD:" style="-fx-font-weight: bold;"/>
        <GridPane hgap="10" vgap="5">
            <children>
                <PasswordField fx:id="txtOldPassword" promptText="Password Lama" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <PasswordField fx:id="txtNewPassword" promptText="Password Baru" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <PasswordField fx:id="txtConfirmPassword" promptText="Konfirmasi Password Baru" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
            </children>
        </GridPane>
        <Button text="GANTI PASSWORD" onAction="#onGantiPassword" styleClass="danger" maxWidth="Infinity"/>

        <Separator/>

        <Label text="ATUR PERTANYAAN KEAMANAN (Untuk Lupa Password):" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtPertanyaanKeamanan" promptText="Contoh: Siapa nama hewan peliharaan pertama saya?"/>
        <PasswordField fx:id="txtJawabanKeamanan" promptText="Masukkan Jawaban (rahasia)"/>
        <Button text="ATUR PERTANYAAN" onAction="#onSetPertanyaan" styleClass="success" maxWidth="Infinity"/>

        <Separator/>
        <Button text="KELOLA AKUN MAHASISWA (Buat Slot, Reset Akun)"
                onAction="#onBukaKelolaAkun" styleClass="info" maxWidth="Infinity"/>

    </VBox>
</ScrollPane>