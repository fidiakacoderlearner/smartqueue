<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="15.0" styleClass="root" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartqueue.controller.MahasiswaLoginController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></padding>

    <Label text="LOGIN MAHASISWA" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>
    <Label fx:id="lblStatus" style="-fx-font-weight: bold;" wrapText="true"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Username (Kelompok):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtUsername" promptText="Cth: Kelompok 1" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="txtPassword" promptText="Password Anda" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="LOGIN" onAction="#onLogin" styleClass="primary, button-large" prefWidth="200"/>

    <Label text="Lupa password? Hubungi Asisten untuk me-reset akun Anda."
           style="-fx-font-style: italic; -fx-text-fill: #555;"/>
    <Separator/>

    <Label text="Belum punya akun?"/>
    <Button text="Daftar Akun Kelompok Di Sini" onAction="#onBukaRegistrasi" styleClass="button-flat"/>

    <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
        <Button text="&lt; Kembali ke Pilih Peran" onAction="#onKembali" styleClass="button-flat"/>
    </HBox>
</VBox>